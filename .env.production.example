APP_NAME="Programa de Ideias"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ideias.sua-empresa.example
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ideias_producao
DB_USERNAME=ideias_app
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
FILESYSTEM_DISK=local
REGISTRATION_ENABLED=false
IDEA_ATTACHMENTS_ENABLED=false
PRIVACY_CONTACT=
READ_NOTIFICATIONS_RETENTION_DAYS=0
VITE_APP_NAME="${APP_NAME}"

CYCLE_TIMEZONE=America/Sao_Paulo

# Primeira versão: contas liberadas pela administração, sem confirmação por e-mail.
EMAIL_VERIFICATION_REQUIRED=false
ACCOUNT_INVITATION_DELIVERY=manual
